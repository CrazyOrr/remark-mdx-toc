{
  "name": "remark-mdx-toc",
  "version": "0.3.1",
  "description": "A remark plugin to generate toc and convert it into MDX export",
  "type": "module",
  "scripts": {
    "build": "rimraf dist && tsc",
    "prepare": "npm run build",
    "pretest": "npm run build",
    "test": "node ./test/test.js"
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "files": [
    "package*.json",
    "dist/*"
  ],
  "keywords": [
    "remark",
    "mdx",
    "toc"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/DCsunset/remark-mdx-toc.git"
  },
  "author": "DCsunset",
  "license": "GPL-3.0",
  "dependencies": {
    "estree-util-value-to-estree": "^3.5.0",
    "mdast-util-to-string": "^4.0.0",
    "unified": "^11.0.5",
    "unist-util-mdx-define": "^1.1.2",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.12.2",
    "remark-custom-header-id": "^1.0.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.2"
  }
}
